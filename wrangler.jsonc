{
  "name": "fantasy-arsenal",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "d1_databases": [{"binding":"DB","database_name":"fantasy-arsenal-db","database_id":"d16a07e7-18c0-4a60-8fec-2259ea88c9b0"}],
  "r2_buckets": [{"binding":"R2","bucket_name":"fantasy-arsenal-media"}],
  "queues": {"producers":[{"binding":"GENERATION_QUEUE","queue":"fantasy-arsenal-generations"}]},
  "observability": {
    "enabled": true
  }
}
